# Vibium Station as a system service: one owner, their rigs and devices.
# Install: docs/how-to-guides/self-host.md. Arguments: /etc/default/station.
[Unit]
Description=Vibium Station (remote access to your rigs' devices)
Documentation=https://github.com/VibiumDev/station
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=station
Group=station
EnvironmentFile=-/etc/default/station
Environment=STATION_DIR=/var/lib/station
ExecStart=/usr/local/bin/station $STATION_ARGS
Restart=always
RestartSec=2
# The station pings systemd while its handler answers; silence for this
# long means a wedged process, which is restarted.
WatchdogSec=30
TimeoutStopSec=10
# Its files: config.json, station.key, station.db, certificates and
# tsnet state. Made at the first start, owned by the service user.
StateDirectory=station
StateDirectoryMode=0700

# The sandbox: a read-only view of the system, no home directories, its
# own /tmp, no device nodes, and only the socket families it serves and
# dials (netlink is for tsnet's view of the host's interfaces).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Refused calls fail with EPERM rather than killing the process: Go's
# runtime raises its file limit with setrlimit at start and shrugs off a
# refusal, but not a signal.
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
# Ports below 1024 without root: :443 and :80 in public mode.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
