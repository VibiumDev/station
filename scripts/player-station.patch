+// ─── Host palette ───────────────────────────────────────────────────────────
+// A same-origin page that frames the player can hand it its own colors: when
+// the parent document defines the Vibium page tokens (--bg, --surface and the
+// rest), the player paints with them and follows the page's theme, so it
+// looks like part of the page. Anything else keeps the palette above.
+const hostTokens = {
+  bg: "--bg",
+  bgCard: "--surface",
+  bgPanel: "--surface-2",
+  border: "--line-card",
+  borderLit: "--line-strong",
+  textDim: "--text-muted",
+  textMid: "--text-3",
+  text: "--text",
+  textAction: "--text-2",
+  orange: "--accent",
+  amber: "--link",
+};
+
+function hostRoot() {
+  try {
+    if (window.parent === window) return null;
+    const root = window.parent.document.documentElement; // throws across origins
+    return getComputedStyle(root).getPropertyValue("--bg").trim() ? root : null;
+  } catch {
+    return null;
+  }
+}
+
+function hostPalette(root) {
+  const style = getComputedStyle(root);
+  const colors = {};
+  for (const [key, token] of Object.entries(hostTokens)) {
+    const v = style.getPropertyValue(token).trim();
+    if (/^#[0-9a-f]{6}$/i.test(v)) colors[key] = v;
+  }
+  if (colors.bgCard) colors.overlayBg = colors.bgCard + "dd";
+  return colors;
+}
+
+function isDarkColor(hex) {
+  if (!hex) return true;
+  const n = parseInt(hex.slice(1, 7), 16);
+  const lum = 0.2126 * (n >> 16) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
+  return lum < 128;
+}
+
